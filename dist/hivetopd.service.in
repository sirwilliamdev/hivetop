[Unit]
Description=hivetop resource monitor daemon
Documentation=https://github.com/sirwilliamdev/hivetop
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=io.github.sirwilliamdev.Hivetop
ExecStart=@BINDIR@/hivetopd
Restart=on-failure
RestartSec=3
Nice=10
MemoryHigh=32M
MemoryMax=64M

[Install]
WantedBy=graphical-session.target
